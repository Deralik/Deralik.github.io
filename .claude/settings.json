{
  "permissions": {
    "deny": [
      "Bash(*git push*)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(*core.hooksPath *)",
      "Bash(*employment-hunter*)",
      "Read(//home/deralik/GitHub/employment-hunter/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/site-edit-reminder.sh" }
        ]
      }
    ]
  }
}
